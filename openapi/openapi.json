    "/v1/discover": {
      "post": {
        "operationId": "postDiscover",
        "summary": "Recent publications on the user's interests, found by the user's own LLM provider",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 512,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "The user's own API key for the chosen provider, from the device's Keychain. Used for this one call and never stored or logged. 16 to 512 printable ASCII characters, no spaces",
              "example": "example-key-not-real-0000"
            },
            "required": true,
            "description": "The user's own API key for the chosen provider, from the device's Keychain. Used for this one call and never stored or logged. 16 to 512 printable ASCII characters, no spaces",
            "name": "x-llm-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoverRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What the search found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discover"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request: no X-LLM-Key header or one of the wrong shape, a body that is not JSON or not sent as application/json, an unknown provider, no interests or more than 20, an interest empty or over 80 characters, or an unknown time zone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          },
          "401": {
            "description": "invalid_key: the provider did not accept the key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          },
          "402": {
            "description": "quota_exceeded: the key's account has no credit or quota left with the provider; retrying will not help until it is topped up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: the provider is limiting requests for this key; try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          },
          "500": {
            "description": "internal_error: something went wrong in the API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          },
          "502": {
            "description": "provider_error: the provider failed or answered in a way that could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          },
          "504": {
            "description": "timeout: the provider took more than 25 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverError"
                }
              }
            }
          }
        }
      }
    }
  }
