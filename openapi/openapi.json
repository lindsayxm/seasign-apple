{
  "openapi": "3.0.3",
  "info": {
    "title": "Seasign API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "seasign-api"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "Sky": {
        "type": "object",
        "properties": {
          "zip": {
            "type": "string",
            "example": "10001"
          },
          "place": {
            "$ref": "#/components/schemas/SkyPlace"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone of the place",
            "example": "America/New_York"
          },
          "utcOffsetSeconds": {
            "type": "integer",
            "description": "The time zone's offset from UTC right now, in seconds. Use `timezone` for other instants",
            "example": -18000
          },
          "current": {
            "$ref": "#/components/schemas/SkyCurrent"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkyDay"
            },
            "description": "Today and tomorrow in the place's time zone, in order"
          }
        },
        "required": [
          "zip",
          "place",
          "timezone",
          "utcOffsetSeconds",
          "current",
          "days"
        ]
      },
      "SkyPlace": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "City or town the zip belongs to",
            "example": "New York"
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "State name",
            "example": "New York"
          },
          "latitude": {
            "type": "number",
            "description": "Degrees north",
            "example": 40.71427
          },
          "longitude": {
            "type": "number",
            "description": "Degrees east",
            "example": -74.00597
          }
        },
        "required": [
          "name",
          "region",
          "latitude",
          "longitude"
        ]
      },
      "SkyCurrent": {
        "type": "object",
        "properties": {
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When these values were measured, as a UTC instant",
            "example": "2026-11-15T11:42:55Z"
          },
          "temperatureF": {
            "type": "number",
            "description": "Air temperature in °F",
            "example": 43.8
          },
          "weatherCode": {
            "type": "integer",
            "description": "WMO weather interpretation code (0 clear … 99 thunderstorm with hail)",
            "example": 0
          },
          "cloudCoverPercent": {
            "type": "number",
            "description": "Total cloud cover, 0–100 percent",
            "example": 4
          },
          "windSpeedMph": {
            "type": "number",
            "description": "Wind speed at 10 m in mph",
            "example": 9.3
          },
          "windGustsMph": {
            "type": "number",
            "description": "Wind gusts at 10 m in mph",
            "example": 25.1
          },
          "isDay": {
            "type": "boolean",
            "description": "True between sunrise and sunset"
          }
        },
        "required": [
          "observedAt",
          "temperatureF",
          "weatherCode",
          "cloudCoverPercent",
          "windSpeedMph",
          "windGustsMph",
          "isDay"
        ]
      },
      "SkyDay": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Calendar date in the place's time zone, YYYY-MM-DD",
            "example": "2026-11-15"
          },
          "sunrise": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Sunrise as a UTC instant; null when the sun does not rise or set that day",
            "example": "2026-11-15T11:42:55Z"
          },
          "sunset": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Sunset as a UTC instant; null when the sun does not rise or set that day",
            "example": "2026-11-15T11:42:55Z"
          },
          "moonrise": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Moonrise as a UTC instant; null when the moon does not rise that day",
            "example": "2026-11-15T11:42:55Z"
          },
          "moonset": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Moonset as a UTC instant; null when the moon does not set that day",
            "example": "2026-11-15T11:42:55Z"
          },
          "moonPhase": {
            "type": "number",
            "description": "Moon phase as a fraction of the cycle: 0 new, 0.25 first quarter, 0.5 full, 0.75 last quarter",
            "example": 0.196
          }
        },
        "required": [
          "date",
          "sunrise",
          "sunset",
          "moonrise",
          "moonset",
          "moonPhase"
        ]
      },
      "SkyError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_zip",
              "unknown_zip",
              "upstream_error"
            ],
            "description": "Machine-readable reason"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "CalendarEvents": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarEvent"
            },
            "description": "Events that have not ended and start within the next 7 days, soonest first, at most 50"
          },
          "calendars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarStatus"
            },
            "description": "One entry per link, in request order"
          }
        },
        "required": [
          "events",
          "calendars"
        ]
      },
      "CalendarEvent": {
        "type": "object",
        "properties": {
          "calendar": {
            "type": "integer",
            "description": "Index of the link in the request this event came from",
            "example": 0
          },
          "title": {
            "type": "string",
            "description": "The event's summary; empty when it has none",
            "example": "Dentist"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Start as a UTC instant. For an all-day event, midnight at the start of `date` in the request's time zone",
            "example": "2026-11-16T15:00:00Z"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "End as a UTC instant. Equal to `start` for an event without a length",
            "example": "2026-11-16T15:00:00Z"
          },
          "allDay": {
            "type": "boolean",
            "description": "True for an event that covers whole days"
          },
          "date": {
            "type": "string",
            "description": "Only for all-day events: the local date the event starts on, YYYY-MM-DD",
            "example": "2026-11-16"
          }
        },
        "required": [
          "calendar",
          "title",
          "start",
          "end",
          "allDay"
        ]
      },
      "CalendarStatus": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Index of the link in the request",
            "example": 0
          },
          "ok": {
            "type": "boolean",
            "description": "True when the calendar was read"
          },
          "partial": {
            "type": "boolean",
            "description": "True when the calendar was read but some of it was left out: an event with a repeat rule that is malformed or not supported, an event that could not be read, or a calendar too large to read in full. Always false when `ok` is false"
          },
          "error": {
            "type": "string",
            "enum": [
              "invalid_link",
              "blocked_host",
              "fetch_failed",
              "timeout",
              "too_large",
              "not_calendar"
            ],
            "description": "Why the calendar could not be read: invalid_link (not an https link), blocked_host (a private or local address), fetch_failed (unreachable or an error status), timeout, too_large, not_calendar (the link did not return an iCalendar file)"
          }
        },
        "required": [
          "index",
          "ok",
          "partial"
        ]
      },
      "CalendarError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "internal_error"
            ],
            "description": "Machine-readable reason"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "CalendarEventsRequest": {
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Calendar links as the user pasted them: a Google \"Secret address in iCal format\", an iCloud published calendar (webcal://), or an Outlook published .ics link. https only; webcal:// is read as https://",
            "example": [
              "https://calendar.example.com/private/calendar.ics"
            ]
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone of the device. Decides when all-day events and events without a time zone start and end. Defaults to UTC",
            "example": "America/New_York"
          }
        },
        "required": [
          "links"
        ]
      },
      "SiteResolve": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "True when the page was read. The other fields are present only then, `error` only otherwise"
          },
          "error": {
            "type": "string",
            "enum": [
              "invalid_url",
              "blocked_host",
              "fetch_failed",
              "timeout",
              "too_large",
              "not_feed",
              "not_html"
            ],
            "description": "Why the page could not be read: invalid_url (not an https address), blocked_host (a private or local address), fetch_failed (unreachable or an error status), timeout, too_large, not_html (neither a web page nor a feed), not_feed (XML that is not RSS or Atom)"
          },
          "title": {
            "type": "string",
            "description": "The page's title, or the feed's when the address is a feed",
            "example": "Science | Example News"
          },
          "url": {
            "type": "string",
            "description": "The address in normal form. Store this and send it to /v1/feed",
            "example": "https://news.example.com/science/"
          },
          "mode": {
            "type": "string",
            "enum": [
              "feed",
              "links"
            ],
            "description": "How the site is followed: feed (an RSS or Atom feed, `feedUrl`) or links (article links read from the page itself). A section page that advertises only a feed for the whole site is followed by its links, so that the user gets the section they asked for"
          },
          "feedUrl": {
            "type": "string",
            "description": "Only with mode feed: the feed the page advertises, or the address itself when it is a feed",
            "example": "https://news.example.com/science/feed/"
          },
          "linkCount": {
            "type": "integer",
            "description": "How many article links the page itself shows right now, at most 200. Present when the address is a web page, absent when it is a feed. With mode links and 0, following this page will give nothing: tell the user",
            "example": 24
          }
        },
        "required": [
          "ok"
        ]
      },
      "SitesError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "internal_error"
            ],
            "description": "Machine-readable reason"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "SiteResolveRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The page the user wants to follow, as typed: a section page of a site, a blog's front page, or a feed. https only",
            "example": "https://news.example.com/science/"
          }
        },
        "required": [
          "url"
        ]
      },
      "Feed": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "description": "Items of the last 7 days from the sites that could be read, newest first; at most 30 per site and 300 in all. A link appears once, under the first site that has it"
          },
          "sites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedSiteStatus"
            },
            "description": "One entry per site, in request order"
          }
        },
        "required": [
          "items",
          "sites"
        ]
      },
      "FeedItem": {
        "type": "object",
        "properties": {
          "site": {
            "type": "integer",
            "description": "Index in the request of the site this item came from",
            "example": 0
          },
          "title": {
            "type": "string",
            "description": "Headline as plain text",
            "example": "A new telescope sees first light"
          },
          "link": {
            "type": "string",
            "description": "The article's address: an absolute https URL",
            "example": "https://news.example.com/science/new-telescope-first-light/"
          },
          "source": {
            "type": "string",
            "description": "Title of the feed or of the site",
            "example": "Example News"
          },
          "published": {
            "type": "string",
            "format": "date-time",
            "description": "A UTC instant at second precision: when the item was published (`dateSource` published), or when this API first saw its link (first_seen)",
            "example": "2026-11-15T11:42:55Z"
          },
          "dateSource": {
            "type": "string",
            "enum": [
              "published",
              "first_seen"
            ],
            "description": "Where `published` comes from: published (the feed's or the page's own date), first_seen (the site gives no readable date for this item, so it is the time this API first found the link; for a site nobody has asked for before, a day before that first fetch)"
          },
          "excerpt": {
            "type": "string",
            "nullable": true,
            "description": "The site's own summary as plain text, about 300 characters at most; null when it gives none (always null in links mode)",
            "example": "The observatory released its first images on Friday…"
          }
        },
        "required": [
          "site",
          "title",
          "link",
          "source",
          "published",
          "dateSource",
          "excerpt"
        ]
      },
      "FeedSiteStatus": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Index of the site in the request",
            "example": 0
          },
          "ok": {
            "type": "boolean",
            "description": "True when the site was read"
          },
          "error": {
            "type": "string",
            "enum": [
              "invalid_url",
              "blocked_host",
              "fetch_failed",
              "timeout",
              "too_large",
              "not_feed",
              "not_html"
            ],
            "description": "Why the site could not be read: invalid_url (not an https address, or mode feed without feedUrl), blocked_host (a private or local address), fetch_failed (unreachable or an error status), timeout (the site, or the request as a whole, ran out of time), too_large, not_feed (mode feed, but the address did not return RSS or Atom), not_html (mode links, but the address did not return a web page)"
          }
        },
        "required": [
          "index",
          "ok"
        ]
      },
      "FeedError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "internal_error"
            ],
            "description": "Machine-readable reason"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "FeedRequest": {
        "type": "object",
        "properties": {
          "sites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedSite"
            },
            "minItems": 1,
            "maxItems": 50,
            "description": "The sites the user follows, 1 to 50"
          }
        },
        "required": [
          "sites"
        ]
      },
      "FeedSite": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The page the user follows, as /v1/sites/resolve returned it",
            "example": "https://news.example.com/science/"
          },
          "mode": {
            "type": "string",
            "enum": [
              "feed",
              "links"
            ],
            "description": "How the site is read, as /v1/sites/resolve returned it"
          },
          "feedUrl": {
            "type": "string",
            "description": "Required with mode feed: the feed's address",
            "example": "https://news.example.com/science/feed/"
          }
        },
        "required": [
          "url",
          "mode"
        ]
      },
      "Discover": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscoverItem"
            },
            "description": "Recent publications found by the provider's web search, at most 20, each link once. Only pages the provider's own search results or citations include are returned; may be empty"
          },
          "provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai",
              "gemini",
              "perplexity"
            ],
            "description": "The provider that was asked"
          },
          "searchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the search was answered, UTC, second precision",
            "example": "2026-11-15T14:00:00Z"
          }
        },
        "required": [
          "items",
          "provider",
          "searchedAt"
        ]
      },
      "DiscoverItem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Headline as plain text, at most 300 characters",
            "example": "A new telescope sees first light"
          },
          "link": {
            "type": "string",
            "description": "The page's address as the provider's search returned it: an absolute https URL",
            "example": "https://news.example.com/science/new-telescope-first-light/"
          },
          "source": {
            "type": "string",
            "description": "Publication or site name, at most 120 characters; the host name when none is given",
            "example": "Example News"
          },
          "published": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "When it was published, as a UTC instant at second precision; null when unknown. Never in the future",
            "example": "2026-11-14T00:00:00Z"
          },
          "excerpt": {
            "type": "string",
            "nullable": true,
            "description": "One sentence on what it is about, written by the model, at most 300 characters; null when it gave none",
            "example": "The observatory released its first images on Friday."
          },
          "interest": {
            "type": "string",
            "nullable": true,
            "description": "Which of the request's interests it matched, as sent; null when unclear",
            "example": "new telescopes"
          }
        },
        "required": [
          "title",
          "link",
          "source",
          "published",
          "excerpt",
          "interest"
        ]
      },
      "DiscoverError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_key",
              "rate_limited",
              "quota_exceeded",
              "provider_error",
              "timeout",
              "internal_error"
            ],
            "description": "Machine-readable reason"
          },
          "message": {
            "type": "string",
            "description": "Fixed human-readable text for the code; never the provider's own words"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "DiscoverRequest": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai",
              "gemini",
              "perplexity"
            ],
            "description": "Whose API the key is for"
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 400
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "Topics to find recent publications on: 1 to 20, each 1 to 80 characters after trimming",
            "example": [
              "tide pools",
              "new telescopes"
            ]
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone of the device; sets what \"today\" is. Defaults to UTC",
            "example": "America/Chicago"
          }
        },
        "required": [
          "provider",
          "interests"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report that the API is running",
        "responses": {
          "200": {
            "description": "The API is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sky": {
      "get": {
        "operationId": "getSky",
        "summary": "Current weather and sun and moon times for a US zip code",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$",
              "description": "5-digit US zip code",
              "example": "10001"
            },
            "required": true,
            "description": "5-digit US zip code",
            "name": "zip",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Weather now, plus sun and moon times for today and tomorrow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sky"
                }
              }
            }
          },
          "400": {
            "description": "The zip is missing or is not five digits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkyError"
                }
              }
            }
          },
          "404": {
            "description": "No US place is known for this zip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkyError"
                }
              }
            }
          },
          "502": {
            "description": "The weather provider failed; try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkyError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calendar/events": {
      "post": {
        "operationId": "postCalendarEvents",
        "summary": "Upcoming events from the user's calendar links",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalendarEventsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upcoming events from the calendars that could be read, and the state of each link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvents"
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON or is not sent as application/json, has no links or more than 10, or names an unknown time zone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "500": {
