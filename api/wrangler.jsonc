/**
 * Wrangler configuration for the Seasign API.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "seasign-api",
	"main": "src/index.ts",
	// Must not be later than the workerd that wrangler and
	// @cloudflare/vitest-plugin install supports (1.20261113.x at the time of
	// writing). Upgrade those packages before raising it.
	"compatibility_date": "2026-11-13",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		// Must equal APP_BUNDLE_ID in ../app-identity.xcconfig.
		// `npm test` runs scripts/check-identity.mjs and fails when they differ.
		"APPLE_APP_BUNDLE_ID": "technology.artisan.seasign",
		// Where Google sends calendar change notifications (events.watch
		// `address`, task 156). Must be https with a valid certificate; it is
		// the deployed Worker's own /v1/google/notify. Not a secret.
		"GOOGLE_WEBHOOK_URL": "https://api.seasign.app/v1/google/notify"
	},
	// Placeholder IDs: enough for `wrangler dev` and the tests, which run locally.
	// The real resources are created only with the user's go-ahead (see AGENTS.md).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "seasign",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "00000000000000000000000000000000"
		}
	],
	// Per-client-IP limits on the open routes (src/lib/rate-limit.ts, task 19).
	// Declaring these creates no cloud resource. Each limit is approximate and
	// counted separately in each Cloudflare location. `period` must be 10 or 60.
	// The numbers must equal RATE_LIMITS in src/lib/rate-limit.ts (a test
	// checks); the reasons are in memory/decisions/2026-11-16-rate-limits-and-deploy-limits.md.
	// namespace_id is ours to choose but must be unique in the Cloudflare
	// account: bindings that share one share their counters.
	"ratelimits": [
		{ "name": "RATE_LIMIT_SKY", "namespace_id": "19001", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RATE_LIMIT_CALENDAR", "namespace_id": "19002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RATE_LIMIT_FEED", "namespace_id": "19003", "simple": { "limit": 15, "period": 60 } },
		{ "name": "RATE_LIMIT_RESOLVE", "namespace_id": "19004", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RATE_LIMIT_DISCOVER", "namespace_id": "19005", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RATE_LIMIT_GOOGLE", "namespace_id": "19006", "simple": { "limit": 600, "period": 60 } },
		{ "name": "RATE_LIMIT_NOTIFY", "namespace_id": "19007", "simple": { "limit": 1200, "period": 60 } }
	]
}
